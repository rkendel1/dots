# OpenDots Configuration
#
# OpenDots is self-hosted. Conversations are stored in FeltDB, model calls go
# straight to the provider you choose, and no CopilotKit hosted service or
# CopilotKit key is used.
#
# Choose the Intelligence provider and model in the Setup screen
# (Configure infrastructure in the sidebar). Setup saves them durably and the
# next request uses them; no restart is needed.
#
# Provider keys are the one thing Setup cannot store: OpenDots never writes a
# credential to its database. Put the key for your provider here and restart.

# ── Server ───────────────────────────────────────────────────────────────────
HOST=127.0.0.1
PORT=4310

# Durable state. FeltDB is the only persistence substrate.
# `data/opendots-state` is created on first run.
# FELTDB_PATH=data/opendots-state
# FELTDB_NAMESPACE=opendots

# Owner identity. Keep stable: it owns your conversations.
OWNER_ID=opendots-owner

# Required for an external HOST binding (24+ characters); enables local login.
# Not needed for localhost/127.0.0.1.
# OWNER_TOKEN=

# npm run dev allows http://127.0.0.1:5173; override for a different origin.
# APP_ORIGIN=http://127.0.0.1:5173

# ── Intelligence provider credentials ────────────────────────────────────────
# Set the key for the provider you select in Setup.
# Anthropic: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=
# OpenAI: https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Optional bootstrap defaults, used only for fields Setup has not saved.
# A saved Setup value always wins. A bootstrap model or base URL is only applied
# to the provider it was written for.
# INTELLIGENCE_PROVIDER=anthropic
# INTELLIGENCE_MODEL=claude-haiku-4-5
# INTELLIGENCE_BASE_URL=
# Legacy OpenAI bootstrap (implies provider "openai" when OPENAI_API_KEY is set):
# OPENAI_MODEL=
# OPENAI_BASE_URL=https://api.openai.com/v1

# CopilotKit's runtime library reports usage to CopilotKit unless this is set.
# OpenDots sets it to true by default; set it to false only to opt back in.
# COPILOTKIT_TELEMETRY_DISABLED=true

# ── Optional: browser service (read-only public-page research) ───────────────
# Use the same random 24+ character secret in both app and browser containers.
BROWSER_SECRET=
# BROWSER_URL=http://127.0.0.1:4311
# BROWSER_HOST=127.0.0.1
# BROWSER_PORT=4311

# ── Optional: voice ──────────────────────────────────────────────────────────
# Realtime voice provider key and model (OpenAI Realtime).
VOICE_API_KEY=
# VOICE_MODEL=
# VOICE_NAME=marin

# ── Optional: computers (persistent execution environments) ──────────────────
# See docs/COMPUTERS.md. Keep these two different random secrets on the server.
# COMPUTER_SUPERVISOR_TOKEN=
# COMPUTER_TOKEN=
# COMPUTER_SUPERVISOR_URL=
# COMPUTER_NAMESPACE=opendots
# COMPUTER_MEMORY_BYTES=2147483648
# COMPUTER_RUNTIME=runsc
# ENGINE_SOCKET=/var/run/docker.sock

# Compute capability boundary (compute.remote@1). See docs/COMPUTE-CAPABILITY-BOUNDARY.md.
# COMPUTE_ENDPOINT=
