# OpenDots Configuration
#
# This file configures OpenDots for bootstrap/deployment. The UI provides a
# configuration interface for managing non-secret settings at runtime.
#
# BOOTSTRAP & DEPLOYMENT CONFIGURATION
# ════════════════════════════════════

# Server listening configuration
HOST=127.0.0.1
PORT=4310

# Durable state. OpenDots uses FeltDB as its sole runtime persistence substrate.
# `data/opendots-state` is created on first run.
# FELTDB_PATH=data/opendots-state
# FELTDB_NAMESPACE=opendots

# Owner identity. Keep stable: it owns persistent Intelligence conversations.
OWNER_ID=opendots-owner

# External deployment: required for an external HOST binding (24+ characters)
# and enables local login. Not needed for localhost/127.0.0.1.
# OWNER_TOKEN=

# npm run dev allows http://127.0.0.1:5173; override for a different origin.
# APP_ORIGIN=http://127.0.0.1:5173

# SECRETS (Environment Only, Not Managed by OpenDots UI)
# ══════════════════════════════════════════════════════
#
# Secrets are configured through environment variables only. The OpenDots UI
# cannot persist or manage secret values. Secret status indicators in the UI
# show whether each secret is configured (yes/no) without exposing the value.
#
# Future AppBoundry integration will allow secrets to be managed through
# SecretReference, but until then, deployment processes must set these values.

# Intelligence API: Required for OpenDots to function
# Obtain from https://copilotkit.ai
INTELLIGENCE_API_KEY=

# OpenAI API: Required for OpenDots to function
# Obtain from https://platform.openai.com/api-keys
OPENAI_API_KEY=
OPENAI_MODEL=

# Optional: Customize OpenAI settings if using a compatible provider
# OPENAI_BASE_URL=https://api.openai.com/v1
# INTELLIGENCE_API_URL=
# INTELLIGENCE_WS_URL=

# Optional: Browser service (read-only public-page isolation)
# Use the same random 24+ character secret in both app and browser containers.
BROWSER_SECRET=
# BROWSER_URL=http://127.0.0.1:4311
# BROWSER_HOST=127.0.0.1
# BROWSER_PORT=4311

# Optional: Voice/realtime speech
# Obtain from your voice provider (e.g., OpenAI for TTS)
VOICE_API_KEY=
# VOICE_MODEL=
# VOICE_NAME=marin

# Optional: Slack integration
# See docs/SETUP.md#slack for setup instructions
# SLACK_CHANNEL_NAME=
# SLACK_TEAM_ID=
# SLACK_USER_IDS=
# SLACK_DOT_ID=

# Optional: Computer services (persistent execution environments)
# See docs/COMPUTERS.md for setup instructions
# Keep these two different random secrets on the server
# COMPUTER_SUPERVISOR_TOKEN=
# COMPUTER_TOKEN=
# COMPUTER_SUPERVISOR_URL=
# COMPUTER_NAMESPACE=opendots
# COMPUTER_MEMORY_BYTES=2147483648
# COMPUTER_RUNTIME=runsc
# ENGINE_SOCKET=/var/run/docker.sock

# UI-MANAGEABLE CONFIGURATION
# ═══════════════════════════
#
# Non-secret settings like model names, URLs, namespaces, etc., can be managed
# through the OpenDots Setup UI and are persisted in FeltDB. These environment
# variables set initial values; UI changes override them at runtime.
#
# To see what can be configured via the UI and what must remain environment-only,
# visit the Setup screen at http://localhost:4310 after starting the server.
