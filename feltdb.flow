flow_version 1

app OpenDots {
  collection settings {
    name: text
    paused: boolean
    researchAllowed: boolean
    memoryAllowed: boolean
  }

  collection spaces {
    id: text
    name: text
    description: text
    createdAt: datetime
  }

  collection dots {
    id: text
    spaceId: ref spaces
    name: text
    instructions: text
    researchAllowed: boolean
    memoryAllowed: boolean
    createdAt: datetime
    learningContainerId: text?
    skillDeliveryEnabled: boolean
  }

  collection dot_space_grants {
    dotId: ref dots
    spaceId: ref spaces
  }

  collection pages {
    id: text
    spaceId: ref spaces
    parentId: ref pages
    title: text
    content: text
    revision: integer
    createdAt: datetime
    updatedAt: datetime
    sourceThreadId: text?
  }

  collection page_reviews {
    pageId: ref pages
    spaceId: ref spaces
  }

  collection thread_bindings {
    id: text
    dotId: ref dots
    ownerId: text
    title: text
    createdAt: datetime
    learningContainerId: text?
  }

  collection page_threads {
    pageId: ref pages
    dotId: ref dots
    threadId: text
    ready: boolean
    leaseUntil: datetime
    index threadId using unique threadId
  }

  collection page_thread_ids {
    threadId: text
  }

  collection tasks {
    id: text
    prompt: text
    status: enum(queued, running, paused, completed, failed, cancelled)
    intervalSeconds: integer?
    nextRunAt: datetime?
    createdAt: datetime
    updatedAt: datetime
    error: text?
    lease: text?
    leaseUntil: datetime?
  }

  collection task_threads {
    taskId: ref tasks
    threadId: text
  }

  collection runs {
    id: text
    taskId: ref tasks
    status: text
    startedAt: datetime
    finishedAt: datetime?
    result: json?
    error: text?
  }

  collection executions {
    id: text
    taskId: text?
    dotId: text?
    status: enum(queued, starting, running, completed, failed, cancelled)
    provider: text
    providerExecutionId: text?
    providerSessionId: text?
    providerStatus: text?
    idempotencyKey: text
    index idempotencyKey using unique idempotencyKey
    prompt: text
    createdAt: datetime
    startedAt: datetime?
    completedAt: datetime?
    result: json?
    errorCode: text?
    error: text?
    lastReconciledAt: datetime?
    resultRetrieved: boolean
    receipt: json?
    reconciliationErrorCode: text?
    reconciliationError: text?
  }

  collection task_events {
    taskId: ref tasks
    runId: text?
    text: text
    createdAt: datetime
    seq: integer
  }

  // The control plane's own record of what a human may need to look at.
  //
  // One row per *condition*, not per event: the id is derived from the condition's
  // identity (kind + source), so repeated evaluation addresses the same row and a
  // durable outage cannot manufacture a new item every cycle. Nothing about an
  // execution is copied here — `sourceId` is a reference, and context is resolved
  // at read time from the execution, task and run that still exist.
  collection attention {
    id: text
    kind: enum(execution_failed, execution_blocked, execution_evidence_pending, provider_unreachable, human_decision_required)
    severity: enum(info, warning, critical)
    status: enum(open, acknowledged, resolved)
    title: text
    summary: text
    sourceType: enum(execution, task, provider)
    sourceId: text
    createdAt: datetime
    updatedAt: datetime
    acknowledgedAt: datetime?
    resolvedAt: datetime?
    // When the underlying condition stopped being true, which is not the same
    // thing as a human resolving the item. Kept apart so "this stopped being a
    // problem" and "a person dealt with it" remain distinguishable forever.
    conditionClearedAt: datetime?
  }

  collection memories {
    id: text
    text: text
    createdAt: datetime
  }

  collection calls {
    id: text
    threadId: text
    startedAt: datetime
    endedAt: datetime?
    status: enum(connecting, active, ended, failed)
    transcript: text
    error: text?
    anchorMessageId: text?
  }

  collection captures {
    threadId: text
    value: json
  }

  collection computer_permissions {
    dotId: ref dots
    enabled: boolean
    browser: boolean
    files: boolean
    shell: boolean
  }

  collection computer_audit {
    id: text
    dotId: ref dots
    action: text
    actor: text
    outcome: text
    createdAt: datetime
  }
}